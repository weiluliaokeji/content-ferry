{
  "name": "contentferry",
  "version": "0.1.5",
  "private": true,
  "description": "Windows-first AI-assisted content creation and publishing workflow.",
  "license": "MIT",
  "author": "weiluliaokeji",
  "homepage": "https://github.com/weiluliaokeji/content-ferry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiluliaokeji/content-ferry.git"
  },
  "bugs": {
    "url": "https://github.com/weiluliaokeji/content-ferry/issues"
  },
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:native && npm run build:main && concurrently -k \"npm:watch:main\" \"npm:dev:renderer\" \"npm:dev:desktop\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "dev:desktop": "wait-on tcp:127.0.0.1:5175 && node scripts/dev-desktop.mjs",
    "watch:main": "tsc --watch -p tsconfig.main.json",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "pack": "node scripts/build-installer.mjs --dir",
    "dist": "node scripts/build-installer.mjs",
    "dist:win": "node scripts/build-installer.mjs --win",
    "dist:portable": "node scripts/build-installer.mjs --win --portable",
    "verify:installer": "node scripts/verify-installer.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@github/copilot-sdk": "^1.0.7",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "@milkdown/react": "^7.21.3",
    "@openai/codex-sdk": "^0.144.6",
    "@resvg/resvg-js": "2.6.2",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.0",
    "mermaid": "^11.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "undici": "^8.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.contentferry.app",
    "productName": "文渡",
    "copyright": "Copyright © 2026 ContentFerry",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "assets/wendu-icon.ico",
      "assets/wendu-icon.png",
      "!**/*.map",
      "!**/__tests__/**",
      "!**/*.test.ts",
      "!**/.DS_Store"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/@openai/codex-win32-x64/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**"
    ],
    "extraMetadata": {
      "main": "dist/main/main/index.js"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "USER-GUIDE.md",
          "images/**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/wendu-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "文渡 ContentFerry",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "publish": null
  }
}
