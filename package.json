{
  "name": "contentferry",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first AI-assisted content creation and publishing workflow.",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:native && npm run build:main && concurrently -k \"npm:watch:main\" \"npm:dev:renderer\" \"npm:dev:desktop\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "dev:desktop": "wait-on tcp:127.0.0.1:5175 && node scripts/dev-desktop.mjs",
    "watch:main": "tsc --watch -p tsconfig.main.json",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "electron --runAsNode -- node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@github/copilot-sdk": "^1.0.7",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "@milkdown/react": "^7.21.3",
    "@openai/codex-sdk": "^0.144.6",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "undici": "^8.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}
