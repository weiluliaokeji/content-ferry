{
  "name": "contentferry",
  "version": "0.3.6",
  "private": true,
  "description": "Windows-first AI-assisted content creation and publishing workflow.",
  "license": "MIT",
  "author": "weiluliaokeji",
  "homepage": "https://github.com/weiluliaokeji/content-ferry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiluliaokeji/content-ferry.git"
  },
  "bugs": {
    "url": "https://github.com/weiluliaokeji/content-ferry/issues"
  },
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:native && npm run build:main && concurrently -k \"npm:watch:main\" \"npm:dev:renderer\" \"npm:dev:desktop\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "dev:desktop": "wait-on tcp:127.0.0.1:5175 && node scripts/dev-desktop.mjs",
    "watch:main": "tsc --watch -p tsconfig.main.json",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "npm run rebuild:native && npm run test:electron",
    "test:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "fix:begin": "node .codex/hooks/verify-fix-test-immutability.mjs --begin",
    "fix:verify": "node .codex/hooks/verify-fix-test-immutability.mjs",
    "fix:end": "node .codex/hooks/verify-fix-test-immutability.mjs --end",
    "fix:test": "node --test scripts/verify-fix-test-immutability.test.mjs scripts/approval-gates.test.mjs",
    "test:installer-abi": "node --test scripts/installer-native-module.test.mjs",
    "eval:agent": "node evals/agent/run.mjs",
    "eval:agent:test": "node --test evals/agent/harness.test.mjs",
    "ci:step": "node scripts/ci-diagnostics.mjs run",
    "ci:diagnostics": "node scripts/ci-diagnostics.mjs collect",
    "ci:triage": "node scripts/ci-triage.mjs",
    "workflows:check": "node scripts/check-workflow-actions.mjs",
    "ci:tooling:test": "node --test scripts/ci-diagnostics.test.mjs scripts/ci-health-report.test.mjs scripts/build-installer.test.mjs scripts/check-workflow-actions.test.mjs",
    "verify:rollback": "npm run rebuild:native && npm run test:electron -- src/main/db/rollback-rehearsal.test.ts",
    "postinstall": "electron-rebuild --only better-sqlite3",
    "rebuild:native": "electron-rebuild -f --only better-sqlite3",
    "pack": "node scripts/build-installer.mjs --dir",
    "dist": "node scripts/build-installer.mjs",
    "dist:win": "node scripts/build-installer.mjs --win",
    "dist:portable": "node scripts/build-installer.mjs --win --portable",
    "verify:installer": "node scripts/verify-installer.mjs",
    "verify:boot": "node scripts/verify-boot.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "@milkdown/react": "^7.22.3",
    "@openai/codex-sdk": "^0.156.1",
    "@resvg/resvg-js": "2.6.2",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.12.7",
    "mermaid": "^12.2.0",
    "node-pty": "1.2.0-beta.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "undici": "^8.12.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "node-abi": "^3.94.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.contentferry.app",
    "productName": "文渡",
    "copyright": "Copyright © 2026 ContentFerry",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "assets/wendu-icon.ico",
      "assets/wendu-icon.png",
      "!**/*.map",
      "!**/__tests__/**",
      "!**/*.test.ts",
      "!**/.DS_Store"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/node-pty/**",
      "**/node_modules/@openai/codex-win32-x64/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**"
    ],
    "extraMetadata": {
      "main": "dist/main/main/index.js"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "USER-GUIDE.md",
          "images/**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/wendu-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ContentFerry-Setup-${version}-${env.CONTENTFERRY_BUILD_STAMP}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "文渡 ContentFerry",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "ContentFerry-Portable-${version}-${env.CONTENTFERRY_BUILD_STAMP}.${ext}",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "publish": null
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
